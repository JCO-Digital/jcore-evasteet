#. Plugin Name of the plugin
#: jcore-evasteet.php
#: includes/class-banner.php:291
msgid "JCORE Evästeet"
msgstr "JCORE Evästeet"

#. Plugin URI of the plugin
#: jcore-evasteet.php
msgid "https://github.com/JCO-Digital/jcore-evasteet"
msgstr "https://github.com/JCO-Digital/jcore-evasteet"

#. Description of the plugin
#: jcore-evasteet.php
msgid "A cookie consent banner wired to Google Consent Mode v2 and the WP Consent API."
msgstr "Evästesuostumusbanneri, joka on kytketty Google Consent Mode v2:een ja WP Consent API:in."

#. Author of the plugin
#: jcore-evasteet.php
msgid "J&Co Digital Oy"
msgstr "J&Co Digital Oy"

#. Author URI of the plugin
#: jcore-evasteet.php
msgid "https://jco.fi"
msgstr "https://jco.fi"

#: includes/admin/class-menu.php:62
#: includes/admin/class-menu.php:63
#: build/admin.js:2
msgid "Cookie consent"
msgstr "Evästesuostumus"

#: includes/class-banner.php:259
msgctxt "cookie banner"
msgid "Cookies"
msgstr "Evästeet"

#: includes/class-banner.php:260
msgid "We use cookies to understand how the site is used and to measure our marketing. Cookies the site needs to work are always on."
msgstr "Käytämme evästeitä ymmärtääksemme, miten sivustoa käytetään, ja mitataksemme markkinointiamme. Sivuston toiminnalle välttämättömät evästeet ovat aina käytössä."

#: includes/class-banner.php:261
msgctxt "cookie banner"
msgid "Privacy Policy"
msgstr "Tietosuojaseloste"

#: includes/class-banner.php:262
msgctxt "cookie banner"
msgid "Accept all"
msgstr "Hyväksy kaikki"

#: includes/class-banner.php:263
msgctxt "cookie banner"
msgid "Reject all"
msgstr "Hylkää kaikki"

#: includes/class-banner.php:264
msgctxt "cookie banner"
msgid "Customize"
msgstr "Mukauta"

#: includes/class-banner.php:265
msgctxt "cookie banner"
msgid "Save choices"
msgstr "Tallenna valinnat"

#: includes/class-banner.php:266
msgctxt "cookie category"
msgid "Necessary"
msgstr "Välttämättömät"

#: includes/class-banner.php:267
msgid "Needed for the site to work, such as keeping you signed in. Always on."
msgstr "Tarvitaan sivuston toimintaan, esimerkiksi kirjautumisen säilyttämiseen. Aina käytössä."

#: includes/class-banner.php:268
msgctxt "cookie category"
msgid "Analytics"
msgstr "Analytiikka"

#: includes/class-banner.php:269
msgid "How the site is used, so we can improve it."
msgstr "Miten sivustoa käytetään, jotta voimme parantaa sitä."

#: includes/class-banner.php:270
msgctxt "cookie category"
msgid "Marketing"
msgstr "Markkinointi"

#: includes/class-banner.php:271
msgid "Measuring our ads and the visitors they bring."
msgstr "Mainontamme ja sen tuomien kävijöiden mittaaminen."

#: includes/class-banner.php:287
msgid "Describe the analytics and marketing tools the site uses, and which category each one falls under."
msgstr "Kuvaile sivuston käyttämät analytiikka- ja markkinointityökalut sekä se, mihin luokkaan kukin kuuluu."

#: includes/class-banner.php:288
msgid "When you first visit this site, a cookie banner asks which optional cookies you allow: analytics and marketing. Cookies the site needs to work are always on. Your answer and the time you gave it are stored in your browser, are not sent to us, and are kept until you change them. You can change your answer at any time from the cookie settings link."
msgstr "Kun vierailet sivustolla ensimmäistä kertaa, evästebanneri kysyy, mitkä valinnaiset evästeet sallit: analytiikka- ja markkinointievästeet. Sivuston toiminnalle välttämättömät evästeet ovat aina käytössä. Vastauksesi ja sen antamisajankohta tallennetaan selaimeesi, niitä ei lähetetä meille, ja ne säilyvät, kunnes muutat niitä. Voit muuttaa vastaustasi milloin tahansa evästeasetusten linkistä."

#: includes/class-plugin.php:117
msgid "Settings"
msgstr "Asetukset"

#: views/admin/page.php:18
msgid "The cookie consent settings need JavaScript."
msgstr "Evästesuostumuksen asetukset vaativat JavaScriptin."

#. translators: %s: error code
#: build/admin.js:2
#, js-format
msgid "Request failed (%s)."
msgstr "Pyyntö epäonnistui (%s)."

#: build/admin.js:2
msgid "Default"
msgstr "Oletus"

#: build/admin.js:2
msgid "Title"
msgstr "Otsikko"

#: build/admin.js:2
msgid "Message"
msgstr "Viesti"

#: build/admin.js:2
msgid "Necessary cookies"
msgstr "Välttämättömät evästeet"

#: build/admin.js:2
msgid "Analytics cookies"
msgstr "Analytiikkaevästeet"

#: build/admin.js:2
msgid "Marketing cookies"
msgstr "Markkinointievästeet"

#: build/admin.js:2
msgid "Background"
msgstr "Tausta"

#: build/admin.js:2
msgid "Text"
msgstr "Teksti"

#: build/admin.js:2
msgid "Buttons"
msgstr "Painikkeet"

#: build/admin.js:2
msgid "Button text"
msgstr "Painikkeiden teksti"

#: build/admin.js:2
msgid "Switches"
msgstr "Kytkimet"

#: build/admin.js:2
msgid "Ask visitors which optional cookies they allow, and pass the answer to Google tags and other plugins."
msgstr "Kysy kävijöiltä, mitkä valinnaiset evästeet he sallivat, ja välitä vastaus Googlen tageille ja muille lisäosille."

#: build/admin.js:2
msgid "Banner"
msgstr "Banneri"

#: build/admin.js:2
msgid "Visitors are asked about analytics and marketing cookies. Cookies the site needs to work are always on and are not asked about."
msgstr "Kävijöiltä kysytään analytiikka- ja markkinointievästeistä. Sivuston toiminnalle välttämättömät evästeet ovat aina käytössä, eikä niistä kysytä."

#: build/admin.js:2
msgid "Show the cookie banner"
msgstr "Näytä evästebanneri"

#: build/admin.js:2
msgid "Leave this off if the site uses another consent manager, such as Cookiebot, CookieYes or Complianz."
msgstr "Jätä tämä pois päältä, jos sivustolla on käytössä toinen suostumustenhallinta, kuten Cookiebot, CookieYes tai Complianz."

#: build/admin.js:2
msgid "Position"
msgstr "Sijainti"

#: build/admin.js:2
msgid "Bottom left"
msgstr "Alhaalla vasemmalla"

#: build/admin.js:2
msgid "Bottom right"
msgstr "Alhaalla oikealla"

#: build/admin.js:2
msgid "Privacy policy"
msgstr "Tietosuojaseloste"

#: build/admin.js:2
msgid "No published privacy policy page is set, so the banner links to none."
msgstr "Julkaistua tietosuojasivua ei ole asetettu, joten banneri ei linkitä mihinkään."

#: build/admin.js:2
msgid "The banner links to the page chosen in the <a>privacy settings</a>. Polylang and WPML point it to the translated page."
msgstr "Banneri linkittää <a>tietosuoja-asetuksissa</a> valittuun sivuun. Polylang ja WPML ohjaavat sen käännettyyn sivuun."

#: build/admin.js:2
msgid "Leave a field empty to use the built-in text, which is shown in the language of the page."
msgstr "Jätä kenttä tyhjäksi käyttääksesi sisäänrakennettua tekstiä, joka näytetään sivun kielellä."

#: build/admin.js:2
msgid "Text written here is in the site's main language. Translate it under <a>string translations</a>."
msgstr "Tähän kirjoitettu teksti on sivuston pääkielellä. Käännä se <a>merkkijonojen käännöksissä</a>."

#: build/admin.js:2
msgid "On a multilingual site, text written here is translated with the string translation of WPML or Polylang."
msgstr "Monikielisellä sivustolla tähän kirjoitettu teksti käännetään WPML:n tai Polylangin merkkijonokäännöksillä."

#: build/admin.js:2
msgid "Appearance"
msgstr "Ulkoasu"

#: build/admin.js:2
msgid "The banner uses the theme's fonts. Reject all and Accept all always look the same, so refusing is as easy as agreeing."
msgstr "Banneri käyttää teeman fontteja. Hylkää kaikki ja Hyväksy kaikki näyttävät aina samalta, jotta kieltäytyminen on yhtä helppoa kuin suostuminen."

#: build/admin.js:2
msgid "Show the switches"
msgstr "Näytä kytkimet"

#: build/admin.js:2
msgid "Google Tag Manager"
msgstr "Google Tag Manager"

#: build/admin.js:2
msgid "The banner always sets Google Consent Mode: everything is denied until the visitor allows it, and every answer updates the signals. GA4 and Google Ads tags follow them; other tags need consent settings in the container."
msgstr "Banneri asettaa aina Google Consent Moden: kaikki on kielletty, kunnes kävijä sallii sen, ja jokainen vastaus päivittää signaalit. GA4- ja Google Ads -tagit noudattavat niitä; muut tagit tarvitsevat suostumusasetukset säilössä."

#: build/admin.js:2
msgid "Container ID"
msgstr "Säilön tunnus"

#: build/admin.js:2
msgid "A container ID looks like GTM-XXXXXXX."
msgstr "Säilön tunnus on muotoa GTM-XXXXXXX."

#: build/admin.js:2
msgid "Optional. Loads the container right after the consent defaults, so no tag can run before them. Leave empty if another plugin or the theme loads it."
msgstr "Valinnainen. Lataa säilön heti suostumuksen oletusarvojen jälkeen, joten mikään tagi ei voi suorittua ennen niitä. Jätä tyhjäksi, jos säilön lataa jokin muu lisäosa tai teema."

#: build/admin.js:2
msgid "Data layer"
msgstr "Datakerros"

#: build/admin.js:2
msgid "Change only if the container uses a data layer other than dataLayer."
msgstr "Muuta vain, jos säilö käyttää jotain muuta datakerrosta kuin dataLayer."

#: build/admin.js:2
msgid "Script blocking"
msgstr "Skriptien esto"

#: build/admin.js:2
msgid "Holds back scripts marked with the cookie category they need until the visitor allows it. Use it for tags that do not follow Google Consent Mode."
msgstr "Pidättää skriptit, joihin on merkitty niiden tarvitsema evästeluokka, kunnes kävijä sallii sen. Käytä tätä tageille, jotka eivät noudata Google Consent Modea."

#: build/admin.js:2
msgid "Block scripts by category"
msgstr "Estä skriptit evästeluokan mukaan"

#: build/admin.js:2
msgid "Scripts without a category are not affected."
msgstr "Tämä ei vaikuta skripteihin, joilla ei ole luokkaa."

#: build/admin.js:2
msgid "Mark a script with data-cookie-category set to analytics or marketing. It runs once the visitor allows that category, right away on later pages. Give it type=\"text/plain\" as well to hold it back for certain, also when another script adds it to the page."
msgstr "Merkitse skriptiin data-cookie-category, jonka arvo on analytics tai marketing. Skripti suoritetaan, kun kävijä sallii luokan, ja myöhemmillä sivuilla heti. Lisää myös type=\"text/plain\", niin skripti pidätetään varmasti, myös kun toinen skripti lisää sen sivulle."

#: build/admin.js:2
msgid "Changing an answer"
msgstr "Vastauksen muuttaminen"

#: build/admin.js:2
msgid "Visitors must be able to change their answer at any time. A link to the address below opens the banner on its switches."
msgstr "Kävijöiden täytyy voida muuttaa vastaustaan milloin tahansa. Linkki alla olevaan osoitteeseen avaa bannerin sen kytkimiin."

#: build/admin.js:2
msgid "Add it as a custom link to the footer <a>menu</a> or a Navigation block, or link to it from any text, for example with the label \"Cookie settings\"."
msgstr "Lisää se mukautettuna linkkinä alatunnisteen <a>valikkoon</a> tai navigaatiolohkoon, tai linkitä siihen mistä tahansa tekstistä, esimerkiksi nimellä \"Evästeasetukset\"."

#: build/admin.js:2
msgid "Add it as a custom link to a Navigation block in the footer, or link to it from any text, for example with the label \"Cookie settings\"."
msgstr "Lisää se mukautettuna linkkinä alatunnisteen navigaatiolohkoon, tai linkitä siihen mistä tahansa tekstistä, esimerkiksi nimellä \"Evästeasetukset\"."

#: build/admin.js:2
msgid "WP Consent API"
msgstr "WP Consent API"

#: build/admin.js:2
msgid "Active. Answers are passed on to plugins that follow the WP Consent API."
msgstr "Käytössä. Vastaukset välitetään WP Consent API:a noudattaville lisäosille."

#: build/admin.js:2
msgid "Not installed. With the WP Consent API plugin, answers are also passed on to plugins that follow it, such as Site Kit."
msgstr "Ei asennettu. WP Consent API -lisäosan kanssa vastaukset välitetään myös sitä noudattaville lisäosille, kuten Site Kitille."

#: build/admin.js:2
#: build/admin.js:3
msgid "Ask everyone again"
msgstr "Kysy kaikilta uudelleen"

#: build/admin.js:2
msgid "When the cookies the site uses or the privacy policy change, ask every visitor again. Answers given before are discarded."
msgstr "Kun sivuston käyttämät evästeet tai tietosuojaseloste muuttuvat, kysy jokaiselta kävijältä uudelleen. Aiemmin annetut vastaukset hylätään."

#. translators: %d: revision number
#: build/admin.js:3
#, js-format
msgid "Current revision: %d"
msgstr "Nykyinen versio: %d"

#: build/admin.js:3
msgid "Every visitor will see the cookie banner again, including those who have already answered. Continue?"
msgstr "Jokainen kävijä näkee evästebannerin uudelleen, myös jo vastanneet. Jatketaanko?"

#: build/admin.js:3
msgid "Every visitor will be asked again."
msgstr "Jokaiselta kävijältä kysytään uudelleen."

#: build/admin.js:3
msgid "Settings saved."
msgstr "Asetukset tallennettu."

#: build/admin.js:3
msgid "Save changes"
msgstr "Tallenna muutokset"
